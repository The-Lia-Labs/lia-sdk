{
  "name": "@lia-labs/elements",
  "version": "0.6.1",
  "description": "Web components for the Lia SDK: <lia-main-button>, <lia-back-button> and more, for any page.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/auto.global.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./auto": "./dist/auto.global.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "lia",
    "mini-app",
    "sdk",
    "web-app"
  ],
  "homepage": "https://docs.lialabs.org/packages",
  "scripts": {
    "build": "rm -rf dist && tsup"
  },
  "dependencies": {
    "@lia-labs/sdk": "0.6.1"
  },
  "unpkg": "./dist/auto.global.js",
  "author": "Lia Labs",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
