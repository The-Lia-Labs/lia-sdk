{
  "name": "@lia-labs/server",
  "version": "0.1.0",
  "description": "Lia server SDK for JavaScript and TypeScript: verified sessions, purchases and signed webhooks.",
  "license": "MIT",
  "author": "Lia Labs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Lia-Labs/lia-sdk.git",
    "directory": "packages/server"
  },
  "homepage": "https://docs.lialabs.org/packages/server"
}
